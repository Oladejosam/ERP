<%- include('layouts/header') %>
<%- include('layouts/sidebar') %>

<main class="col-lg-10 p-4">
    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="window.history.back();">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="card shadow-sm border-0 rounded-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Warehouse & Inventory</h2>
                    <p class="text-muted mb-0">Track materials stock, reorder levels, and site dispatches for <strong><%= company.company_name %></strong>.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-warning text-dark rounded-3" type="button" data-bs-toggle="modal" data-bs-target="#issueStockModal">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Issue Stock
                    </button>
                    <button class="btn btn-primary rounded-3" type="button" data-bs-toggle="modal" data-bs-target="#addItemModal">
                        <i class="bi bi-plus-lg me-1"></i>New Item
                    </button>
                </div>
            </div>

            <% if (typeof flash !== 'undefined' && flash) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i><%= flash %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Item Code</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Stock Level</th>
                            <th>Cost Price</th>
                            <th>Selling Price</th>
                            <th>Location / Bin</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach(function(item) { %>
                            <tr>
                                <td><span class="badge bg-secondary-subtle text-secondary font-monospace"><%= item.item_code %></span></td>
                                <td>
                                    <div class="fw-bold text-dark"><%= item.name %></div>
                                    <small class="text-muted">Supplier: <%= item.supplier_name %></small>
                                </td>
                                <td><span class="badge bg-light text-dark border"><%= item.category %></span></td>
                                <td>
                                    <div class="d-flex align-items-baseline gap-1">
                                        <span class="fw-bold fs-5 <%= item.current_stock <= item.reorder_level ? 'text-danger' : 'text-dark' %>"><%= item.current_stock %></span>
                                        <small class="text-muted"><%= item.unit %></small>
                                    </div>
                                    <small class="text-muted d-block">Reorder: <%= item.reorder_level %> <%= item.unit %></small>
                                </td>
                                <td class="fw-semibold">₦<%= (item.cost_price).toLocaleString('en-US') %></td>
                                <td class="text-muted">₦<%= (item.selling_price).toLocaleString('en-US') %></td>
                                <td><i class="bi bi-geo text-secondary me-1"></i><%= item.warehouse_bin %></td>
                                <td>
                                    <% if (item.current_stock <= item.reorder_level) { %>
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock</span>
                                    <% } else { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Adequate</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<!-- Add Item Modal -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Register New Inventory Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/inventory/save">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item Code</label>
                        <input class="form-control" name="item_code" placeholder="INV-MAT-007" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item Name / Description</label>
                        <input class="form-control" name="name" placeholder="e.g. PVC Pressure Pipe 4 Inch" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category</label>
                            <input class="form-control" name="category" placeholder="Plumbing & MEP" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Unit of Measure</label>
                            <input class="form-control" name="unit" placeholder="Lengths / Bags / Tons" required>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Cost Price (₦)</label>
                            <input class="form-control" type="number" name="cost_price" required value="5000">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Selling/Billing (₦)</label>
                            <input class="form-control" type="number" name="selling_price" required value="6500">
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Initial Stock</label>
                            <input class="form-control" type="number" name="current_stock" required value="100">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Reorder Threshold</label>
                            <input class="form-control" type="number" name="reorder_level" required value="20">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Supplier Name</label>
                        <input class="form-control" name="supplier_name" placeholder="e.g. BuildMart Depot" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Warehouse Bin Location</label>
                        <input class="form-control" name="warehouse_bin" placeholder="e.g. Bay D-02" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Item</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Issue Stock Modal -->
<div class="modal fade" id="issueStockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Issue / Allocate Materials to Project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/inventory/issue">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Material</label>
                        <select class="form-select" name="item_id" required>
                            <% items.forEach(function(item) { %>
                                <option value="<%= item.id %>"><%= item.name %> (Available: <%= item.current_stock %> <%= item.unit %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Destination Project</label>
                        <select class="form-select" name="project_id" required>
                            <% projects.forEach(function(p) { %>
                                <option value="<%= p.id %>"><%= p.name %> (<%= p.project_number %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity to Issue</label>
                        <input class="form-control" type="number" min="1" name="quantity" value="10" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Waybill / Dispatch Notes</label>
                        <textarea class="form-control" name="notes" rows="2" placeholder="e.g. Loaded on truck BD-42 for pier casting."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark fw-semibold">Confirm Stock Issue</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('layouts/footer') %>
