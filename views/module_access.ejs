<%- include('layouts/header') %>
<%- include('layouts/sidebar') %>

<main class="col-lg-10 p-4">
    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="window.history.back();">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
        <h2 class="fw-bold mb-1">Role-Based Module Access Matrix</h2>
        <p class="text-muted mb-4">Control operational permissions and module visibility across organizational job roles.</p>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Role Title</th>
                        <th class="text-center">Projects</th>
                        <th class="text-center">Inventory</th>
                        <th class="text-center">Requisitions</th>
                        <th class="text-center">Procurement</th>
                        <th class="text-center">HR & Payroll</th>
                        <th class="text-center">Accounting</th>
                        <th class="text-center">Admin</th>
                    </tr>
                </thead>
                <tbody>
                    <% roles.forEach(function(r) { %>
                        <tr>
                            <td class="fw-bold text-dark"><%= r.name %></td>
                            <td class="text-center"><i class="bi bi-check-circle-fill text-success fs-5"></i></td>
                            <td class="text-center"><i class="bi bi-check-circle-fill text-success fs-5"></i></td>
                            <td class="text-center"><i class="bi bi-check-circle-fill text-success fs-5"></i></td>
                            <td class="text-center">
                                <% if (['Staff', 'Site Engineer'].includes(r.name)) { %>
                                    <i class="bi bi-dash text-muted fs-5"></i>
                                <% } else { %>
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <% } %>
                            </td>
                            <td class="text-center">
                                <% if (['HR Manager', 'Super Administrator', 'Managing Director'].includes(r.name)) { %>
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <% } else { %>
                                    <i class="bi bi-dash text-muted fs-5"></i>
                                <% } %>
                            </td>
                            <td class="text-center">
                                <% if (['Accountant', 'Finance Manager', 'Super Administrator', 'Managing Director'].includes(r.name)) { %>
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <% } else { %>
                                    <i class="bi bi-dash text-muted fs-5"></i>
                                <% } %>
                            </td>
                            <td class="text-center">
                                <% if (['Super Administrator'].includes(r.name)) { %>
                                    <i class="bi bi-shield-fill-check text-primary fs-5"></i>
                                <% } else { %>
                                    <i class="bi bi-dash text-muted fs-5"></i>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<%- include('layouts/footer') %>
