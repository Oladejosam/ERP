<%- include('layouts/header') %>
<%- include('layouts/sidebar') %>

<main class="col-lg-10 p-4">
    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="window.history.back();">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Financial Accounting & Ledger</h2>
            <p class="text-muted mb-0">Contract billing, payment disbursements, and expenditure audit for <strong><%= company.company_name %></strong>.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/management/hr" class="btn btn-outline-secondary">
                <i class="bi bi-receipt me-1"></i>Payroll Runs
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newPaymentModal">
                <i class="bi bi-plus-lg me-1"></i>Disburse Payment
            </button>
        </div>
    </div>

    <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i><%= flash %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="row g-4">
        <!-- Financial KPIs -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <small class="text-muted fw-semibold text-uppercase">Billed Revenue</small>
                <h3 class="fw-bold text-success mt-2 mb-0">₦285,400,000</h3>
                <small class="text-muted">Interim certificates</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <small class="text-muted fw-semibold text-uppercase">Total Disbursed</small>
                <h3 class="fw-bold text-danger mt-2 mb-0">₦192,850,000</h3>
                <small class="text-muted">Procurement & payroll</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <small class="text-muted fw-semibold text-uppercase">Net Margin</small>
                <h3 class="fw-bold text-primary mt-2 mb-0">₦92,550,000</h3>
                <small class="text-muted">Operating profit (32.4%)</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <small class="text-muted fw-semibold text-uppercase">Accounts Payable</small>
                <h3 class="fw-bold text-warning mt-2 mb-0">₦19,600,000</h3>
                <small class="text-muted">Suppliers due 30 days</small>
            </div>
        </div>

        <!-- Vendor Payments Schedule -->
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-credit-card-2-front me-2 text-primary"></i>Purchase Payment Disbursements</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>PO Ref</th>
                                <th>Supplier</th>
                                <th>Project Allocation</th>
                                <th>Total Order Value</th>
                                <th>Payment Terms</th>
                                <th>Status</th>
                                <th class="text-end">Voucher</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% purchaseOrders.forEach(function(po) { %>
                                <tr>
                                    <td><span class="badge bg-secondary-subtle text-secondary font-monospace"><%= po.po_number %></span></td>
                                    <td class="fw-bold text-dark"><%= po.supplier_name %></td>
                                    <td><%= po.project_name %></td>
                                    <td class="fw-semibold">₦<%= (po.total_amount).toLocaleString('en-US') %></td>
                                    <td><span class="badge bg-light text-dark border">Direct Wire Transfer</span></td>
                                    <td>
                                        <% if (po.payment_status === 'paid') { %>
                                            <span class="badge bg-success-subtle text-success">Cleared & Reconciled</span>
                                        <% } else { %>
                                            <span class="badge bg-warning-subtle text-warning">Pending Final Signoff</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-secondary" onclick="alert('Payment Voucher PV-2026-<%= po.id %> generated successfully.');">
                                            <i class="bi bi-file-earmark-pdf me-1"></i>Print Voucher
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="newPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Record Disbursement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/modules/accounting/purchase-payment/save">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Beneficiary</label>
                        <input class="form-control" name="beneficiary" placeholder="Vendor or Subcontractor Name" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Disbursement Amount (₦)</label>
                        <input class="form-control" type="number" name="amount" value="500000" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Account / Ledger Head</label>
                        <select class="form-select" name="account">
                            <option value="Direct Project Material Costs">Direct Project Material Costs</option>
                            <option value="Subcontractor Interim Payment">Subcontractor Interim Payment</option>
                            <option value="Equipment Fuel & Maintenance">Equipment Fuel & Maintenance</option>
                            <option value="Site Logistics & Operations">Site Logistics & Operations</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Process Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('layouts/footer') %>
