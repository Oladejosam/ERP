<%- include('layouts/header') %>
<%- include('layouts/sidebar') %>

<main class="col-lg-10 p-4">
    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="window.history.back();">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            <i class="bi bi-person-circle fs-1 text-primary"></i>
            <div>
                <h3 class="fw-bold mb-0"><%= user.name %></h3>
                <span class="badge bg-primary-subtle text-primary"><%= user.role_name %></span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label text-muted small fw-semibold">Email Address</label>
                <input class="form-control" value="<%= user.email %>" readonly>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted small fw-semibold">Role Name</label>
                <input class="form-control" value="<%= user.role_name %>" readonly>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted small fw-semibold">Current Active Tenant</label>
                <input class="form-control" value="<%= company.company_name %>" readonly>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted small fw-semibold">Account Status</label>
                <input class="form-control text-success fw-bold" value="Active & Authorized" readonly>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top d-flex gap-2">
            <a href="/logout" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Sign Out</a>
            <a href="/dashboard" class="btn btn-primary btn-sm"><i class="bi bi-speedometer2 me-1"></i>Return to Dashboard</a>
        </div>
    </div>
</main>

<%- include('layouts/footer') %>
