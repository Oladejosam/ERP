<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' | Construction ERP' : 'Construction ERP System' %></title>
    <meta name="description" content="Enterprise-grade ERP platform for construction companies featuring project management, inventory, procurement, requisitions, HR, and role-based portals.">
    <meta property="og:title" content="Construction ERP System">
    <meta property="og:description" content="Enterprise-grade ERP platform for construction companies featuring project management, inventory, procurement, requisitions, HR, and role-based portals.">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background: #f4f7fb; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
        .sidebar-card { border-radius: 18px; }
        .nav-link { color: #475569; border-radius: 10px; padding: 10px 12px; transition: all 0.15s ease; }
        .nav-link.active { background: #e0ecff; color: #0f172a; font-weight: 600; }
        .nav-link:hover { background: #edf3ff; color: #1e293b; }
        @media (min-width: 992px) {
            .sidebar-column { position: sticky; top: 1rem; align-self: flex-start; max-height: calc(100vh - 2rem); overflow-y: auto; }
        }
        :root { --theme-color: <%= (typeof company !== 'undefined' && company && company.theme_color) ? company.theme_color : '#1d4ed8' %>; }
        .topbar { background: linear-gradient(135deg, #0f172a, var(--theme-color)); }
        .brand-logo { max-height: 38px; max-width: 180px; object-fit: contain; }
        .menu-heading { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
        .menu-toggle { color: #475569; border-color: #cbd5e1; flex-shrink: 0; }
        .menu-toggle:hover { color: #0f172a; background: #edf3ff; border-color: #94a3b8; }
        .sidebar-column, main { transition: flex-basis .2s ease, max-width .2s ease; }
        .menu-collapsed .sidebar-column { flex: 0 0 76px; max-width: 76px; }
        .menu-collapsed main { flex: 0 0 calc(100% - 76px); max-width: calc(100% - 76px); }
        .menu-collapsed .sidebar-column .card-body { padding: .75rem .5rem !important; }
        .menu-collapsed .sidebar-column h6,
        .menu-collapsed .sidebar-column .nav-link span { display: none; }
        .menu-collapsed .sidebar-column .nav-link { text-align: center; padding-left: .5rem; padding-right: .5rem; }
        .menu-collapsed .sidebar-column .nav-link i { font-size: 1.25rem; margin-right: 0 !important; }
        @media (max-width: 991.98px) {
            .menu-collapsed .sidebar-column { display: none; }
            .menu-collapsed main { flex-basis: 100%; max-width: 100%; }
        }
    </style>
</head>
<body>
<div class="container-fluid p-0">
    <nav class="topbar navbar navbar-expand-lg navbar-dark px-4 py-3">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/dashboard">
            <% if (typeof company !== 'undefined' && company && company.logo_path) { %>
                <img class="brand-logo bg-white p-1 rounded" src="/uploads/<%= company.logo_path %>" alt="<%= company.company_name %>">
                <span class="d-none d-md-inline ms-1"><%= company.company_name %></span>
            <% } else { %>
                <i class="bi bi-buildings-fill text-warning fs-4"></i>
                <span><%= typeof company !== 'undefined' && company ? company.company_name : 'Construction ERP' %></span>
            <% } %>
        </a>
        <div class="ms-auto d-flex align-items-center gap-3 text-white">
            <% if (typeof impersonating !== 'undefined' && impersonating) { %>
                <a class="btn btn-warning btn-sm fw-semibold" href="/stop-impersonation"><i class="bi bi-arrow-return-left me-1"></i>Return to Super Admin</a>
            <% } %>
            
            <% if (typeof companies !== 'undefined' && companies.length > 1) { %>
                <form method="post" action="/setup/select-company" class="d-flex align-items-center">
                    <label class="visually-hidden" for="headerCompanySelect">Company</label>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary" id="headerCompanySelect" name="company_id" onchange="this.form.submit()">
                        <% companies.forEach(function(c) { %>
                            <option value="<%= c.id %>" <%= (typeof company !== 'undefined' && company.id === c.id) ? 'selected' : '' %>><%= c.company_name %></option>
                        <% }); %>
                    </select>
                </form>
            <% } %>

            <span class="badge bg-success-subtle text-success px-2 py-2 border border-success-subtle">
                <i class="bi bi-shield-check me-1"></i><%= (typeof user !== 'undefined' && user && user.role_name) ? user.role_name : 'Staff' %>
            </span>
            
            <a class="text-white text-decoration-none position-relative" href="/modules/chat" title="Team Chat">
                <i class="bi bi-chat-dots fs-5"></i>
                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
            </a>

            <div class="dropdown">
                <a class="text-white text-decoration-none d-flex align-items-center gap-2 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle fs-4"></i>
                    <div class="text-start d-none d-sm-block">
                        <div class="fw-semibold lh-1"><%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Guest' %></div>
                        <small class="text-white-50"><%= (typeof user !== 'undefined' && user && user.role_name) ? user.role_name : 'Portal User' %></small>
                    </div>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><h6 class="dropdown-header"><%= (typeof user !== 'undefined' && user && user.email) ? user.email : '' %></h6></li>
                    <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                    <% if (typeof user !== 'undefined' && user && user.role_name) { %>
                        <li><a class="dropdown-item" href="/portal/<%= user.role_name.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><i class="bi bi-grid me-2"></i>My Portal View</a></li>
                    <% } %>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="row g-0">
