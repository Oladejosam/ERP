<%- include('layouts/header') %>
<%- include('layouts/sidebar') %>

<main class="col-lg-10 p-4">
    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="window.history.back();">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Human Resources & Payroll Administration</h2>
            <p class="text-muted mb-0">Manage organizational departments, salary advances, and employee loans.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#advanceModal">
                <i class="bi bi-cash me-1"></i>Request Advance
            </button>
            <form method="post" action="/management/payroll/run">
                <button type="submit" class="btn btn-success fw-semibold">
                    <i class="bi bi-play-circle me-1"></i>Execute Monthly Payroll Run
                </button>
            </form>
        </div>
    </div>

    <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i><%= flash %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="row g-4">
        <!-- Departments Overview -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-diagram-2 me-2 text-primary"></i>Company Departments</h5>
                    <span class="badge bg-primary-subtle text-primary"><%= departments.length %> Units</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Department Name</th>
                                    <th>Head of Department</th>
                                    <th class="text-end pe-4">Personnel</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% departments.forEach(function(d) { %>
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark"><%= d.name %></td>
                                        <td><%= d.head_name %></td>
                                        <td class="text-end pe-4">
                                            <span class="badge bg-secondary-subtle text-secondary"><%= d.employee_count %> Staff</span>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Salary Advance Requests -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-wallet2 me-2 text-warning"></i>Salary Advance Requests</h5>
                    <span class="badge bg-warning-subtle text-warning"><%= salaryAdvances.length %> Total</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Employee</th>
                                    <th>Amount</th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Decision</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% salaryAdvances.forEach(function(sa) { %>
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark"><%= sa.employee_name %></div>
                                            <small class="text-muted"><%= sa.department %></small>
                                        </td>
                                        <td class="fw-semibold">₦<%= (sa.amount).toLocaleString('en-US') %></td>
                                        <td class="small text-secondary"><%= sa.reason %></td>
                                        <td>
                                            <% if (sa.status === 'approved') { %>
                                                <span class="badge bg-success-subtle text-success">Approved</span>
                                            <% } else { %>
                                                <span class="badge bg-warning-subtle text-warning">Pending</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end pe-4">
                                            <% if (sa.status === 'pending') { %>
                                                <form method="post" action="/management/salary-advances/approve" class="d-inline">
                                                    <input type="hidden" name="id" value="<%= sa.id %>">
                                                    <button class="btn btn-sm btn-outline-success"><i class="bi bi-check"></i></button>
                                                </form>
                                            <% } else { %>
                                                <i class="bi bi-check-all text-success fs-5"></i>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employee Loans -->
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-bank me-2 text-success"></i>Employee Staff Loans & Amortization</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Staff Member</th>
                                <th>Principal Loan</th>
                                <th>Tenure</th>
                                <th>Monthly Deduction</th>
                                <th>Outstanding Balance</th>
                                <th>Start Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% employeeLoans.forEach(function(l) { %>
                                <tr>
                                    <td class="fw-bold text-dark"><%= l.employee_name %></td>
                                    <td class="fw-semibold">₦<%= (l.principal).toLocaleString('en-US') %></td>
                                    <td><%= l.tenure_months %> Months</td>
                                    <td>₦<%= (l.monthly_deduction).toLocaleString('en-US') %></td>
                                    <td class="fw-bold text-danger">₦<%= (l.balance).toLocaleString('en-US') %></td>
                                    <td class="small text-muted"><%= l.start_date %></td>
                                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Active</span></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Advance Request Modal -->
<div class="modal fade" id="advanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Request Salary Advance</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/management/salary-advances/request">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Employee Name</label>
                        <select class="form-select" name="employee_name" required>
                            <% employees.forEach(function(e) { %>
                                <option value="<%= e.first_name %> <%= e.last_name %>"><%= e.first_name %> <%= e.last_name %> (<%= e.department %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Advance Amount (₦)</label>
                        <input class="form-control" type="number" name="amount" value="50000" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason for Advance</label>
                        <textarea class="form-control" name="reason" rows="2" placeholder="e.g. Urgent family necessity" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('layouts/footer') %>
