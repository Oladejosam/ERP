<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Login | Construction ERP' %></title>
    <meta name="description" content="Sign in to Construction ERP System.">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #07111f 0%, #17408a 100%);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
        }
        .auth-shell {
            max-width: 1050px;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
        }
        .hero-panel {
            background: linear-gradient(145deg, #0b1528 10%, #1e3a8a 100%);
        }
        .form-control {
            border-radius: 12px;
            padding: 0.75rem 0.95rem;
        }
        .btn-primary {
            border-radius: 12px;
            padding: 0.8rem 1rem;
        }
        .quick-btn {
            border-radius: 10px;
            text-align: left;
            transition: all 0.2s ease;
        }
        .quick-btn:hover {
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">

<div class="auth-shell row g-0 bg-white w-100 my-4">
    <div class="hero-panel col-lg-5 p-5 text-white d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-buildings-fill text-warning fs-3"></i>
                <h4 class="fw-bold mb-0 text-white"><%= company ? company.company_name : 'Construction ERP' %></h4>
            </div>
            <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill fw-bold">Secure ERP Access</span>
            <h2 class="fw-bold">Enterprise Portal</h2>
            <p class="mt-3 text-light opacity-75">
                Integrated construction management, materials requisition, real-time site logging, and payroll accounting.
            </p>
        </div>

        <div class="mt-4 pt-4 border-top border-white-50">
            <h6 class="text-warning fw-semibold mb-2"><i class="bi bi-lightning-charge me-1"></i>One-Click Demo Profiles</h6>
            <p class="small text-light opacity-75 mb-3">Click any profile below to instantly log in with pre-configured permissions:</p>
            <div class="d-grid gap-2">
                <form method="post" action="/login">
                    <input type="hidden" name="email" value="superadmin@erp.com">
                    <input type="hidden" name="password" value="SuperAdmin123!">
                    <button type="submit" class="btn btn-outline-light quick-btn w-100 btn-sm d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-shield-lock text-danger me-2"></i>Super Administrator</span>
                        <span class="badge bg-danger">Full Root</span>
                    </button>
                </form>
                <form method="post" action="/login">
                    <input type="hidden" name="email" value="md@lubell.com">
                    <input type="hidden" name="password" value="Password123!">
                    <button type="submit" class="btn btn-outline-light quick-btn w-100 btn-sm d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-briefcase text-info me-2"></i>Managing Director</span>
                        <span class="badge bg-info">Executive</span>
                    </button>
                </form>
                <form method="post" action="/login">
                    <input type="hidden" name="email" value="site.engineer@lubell.com">
                    <input type="hidden" name="password" value="Password123!">
                    <button type="submit" class="btn btn-outline-light quick-btn w-100 btn-sm d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-cone-striped text-warning me-2"></i>Site Engineer</span>
                        <span class="badge bg-warning text-dark">Field Lead</span>
                    </button>
                </form>
                <form method="post" action="/login">
                    <input type="hidden" name="email" value="accountant@lubell.com">
                    <input type="hidden" name="password" value="Password123!">
                    <button type="submit" class="btn btn-outline-light quick-btn w-100 btn-sm d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-receipt text-success me-2"></i>Accountant</span>
                        <span class="badge bg-success">Finance</span>
                    </button>
                </form>
                <form method="post" action="/login">
                    <input type="hidden" name="email" value="procurement@lubell.com">
                    <input type="hidden" name="password" value="Password123!">
                    <button type="submit" class="btn btn-outline-light quick-btn w-100 btn-sm d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-cart3 text-primary me-2"></i>Procurement Officer</span>
                        <span class="badge bg-primary">Purchasing</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7 p-4 p-lg-5 d-flex flex-column justify-content-center">
        <div class="text-center mb-4">
            <h3 class="fw-bold">Sign In to Your Workspace</h3>
            <p class="text-muted mb-0">Enter your credentials or choose a one-click profile</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div><%= success %></div>
            </div>
        <% } %>

        <form method="post" action="/login">
            <div class="mb-3">
                <label class="form-label fw-semibold" for="loginEmail">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email" class="form-control" id="loginEmail" name="email" value="<%= typeof emailValue !== 'undefined' ? emailValue : 'superadmin@erp.com' %>" required>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label fw-semibold" for="loginPassword">Password</label>
                    <small class="text-muted">Default: SuperAdmin123!</small>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control" id="loginPassword" name="password" value="SuperAdmin123!" required>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe" name="remember_me" checked>
                    <label class="form-check-label text-muted" for="rememberMe">Remember me</label>
                </div>
                <a href="/" class="text-decoration-none small text-primary fw-semibold"><i class="bi bi-arrow-left me-1"></i>Back to Landing Page</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
        </form>

        <div class="text-center mt-4 text-muted small">
            Need help? Contact system administrator or switch to a demo profile above.
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
