<%- include('layouts/header') %>
<%- include('layouts/sidebar') %>

<main class="col-lg-10 p-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 bg-white p-4 rounded-4 shadow-sm border-0">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="fw-bold mb-0">Construction ERP Dashboard</h2>
                        <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill border border-success-subtle">
                            <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.6rem;"></i> Live System
                        </span>
                    </div>
                    <p class="text-muted mb-0">
                        Operational intelligence for <strong><%= company.company_name %></strong>. Logged in as <strong><%= user.name %></strong> (<%= user.role_name %>).
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/requisition" class="btn btn-primary btn-sm rounded-3">
                        <i class="bi bi-plus-lg me-1"></i>New Requisition
                    </a>
                    <a href="/modules/projects" class="btn btn-outline-secondary btn-sm rounded-3">
                        <i class="bi bi-building me-1"></i>View Projects
                    </a>
                </div>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Active Projects</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= stats.projectsCount %></h3>
                            <small class="text-success"><i class="bi bi-arrow-up-right me-1"></i>All on track</small>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-4 fs-3">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Inventory Items</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= stats.inventoryCount %></h3>
                            <small class="<%= stats.lowStockCount > 0 ? 'text-danger fw-semibold' : 'text-muted' %>">
                                <i class="bi bi-exclamation-circle me-1"></i><%= stats.lowStockCount %> items low stock
                            </small>
                        </div>
                        <div class="bg-warning-subtle text-warning p-3 rounded-4 fs-3">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Requisitions</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= stats.requisitionsCount %></h3>
                            <small class="text-primary"><i class="bi bi-clock me-1"></i><%= stats.pendingRequisitions %> pending approvals</small>
                        </div>
                        <div class="bg-info-subtle text-info p-3 rounded-4 fs-3">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Staff Roster</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= stats.employeesCount %></h3>
                            <small class="text-secondary"><i class="bi bi-check2-circle me-1"></i>Active personnel</small>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-4 fs-3">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Summary -->
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <div class="row g-4 text-center text-md-start">
                    <div class="col-md-4 border-end-md">
                        <small class="text-uppercase text-muted fw-semibold">Contract Portfolio Value</small>
                        <h4 class="fw-bold text-primary mt-1 mb-0">₦<%= (stats.contractTotal).toLocaleString('en-US') %></h4>
                    </div>
                    <div class="col-md-4 border-end-md">
                        <small class="text-uppercase text-muted fw-semibold">Allocated Project Budgets</small>
                        <h4 class="fw-bold text-dark mt-1 mb-0">₦<%= (stats.budgetTotal).toLocaleString('en-US') %></h4>
                    </div>
                    <div class="col-md-4">
                        <small class="text-uppercase text-muted fw-semibold">Active Purchase Orders</small>
                        <h4 class="fw-bold text-success mt-1 mb-0"><%= stats.purchaseOrdersCount %> Orders</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Projects Overview Table -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-building me-2 text-primary"></i>Ongoing Projects</h5>
                    <a href="/modules/projects" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Project</th>
                                    <th>Client</th>
                                    <th>Contract Value</th>
                                    <th>Progress</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% projects.forEach(function(project) { %>
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold"><%= project.name %></div>
                                            <small class="text-muted"><%= project.project_number %></small>
                                        </td>
                                        <td><%= project.client_name %></td>
                                        <td class="fw-semibold">₦<%= (project.contract_value).toLocaleString('en-US') %></td>
                                        <td style="min-width: 130px;">
                                            <div class="d-flex justify-content-between small text-muted mb-1">
                                                <span>Completion</span>
                                                <span class="fw-bold"><%= project.progress_percent %>%</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: <%= project.progress_percent %>%;"></div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary text-capitalize">
                                                <%= project.status.replace('_', ' ') %>
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="/projects/detail?id=<%= project.id %>" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Requisitions -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2 text-warning"></i>Requisitions</h5>
                    <a href="/requisition" class="btn btn-sm btn-outline-warning text-dark">View All</a>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="list-group list-group-flush">
                        <% requisitions.forEach(function(req) { %>
                            <div class="list-group-item px-0 py-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div class="fw-bold text-dark"><%= req.requisition_no %></div>
                                    <% if (req.status === 'approved') { %>
                                        <span class="badge bg-success-subtle text-success">Approved</span>
                                    <% } else if (req.status === 'dispatched') { %>
                                        <span class="badge bg-info-subtle text-info">Dispatched</span>
                                    <% } else { %>
                                        <span class="badge bg-warning-subtle text-warning">Pending</span>
                                    <% } %>
                                </div>
                                <div class="small text-muted mb-1"><%= req.project_name %></div>
                                <div class="d-flex justify-content-between align-items-center small">
                                    <span class="text-secondary"><i class="bi bi-person me-1"></i><%= req.requested_by_name %></span>
                                    <span class="fw-bold text-dark">₦<%= (req.total_amount).toLocaleString('en-US') %></span>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <div class="mt-3">
                        <a href="/requisition" class="btn btn-primary w-100 btn-sm rounded-3">
                            <i class="bi bi-plus-lg me-1"></i>Create Requisition
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventory Stock Alerts -->
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-box-seam me-2 text-warning"></i>Warehouse Inventory Snapshot</h5>
                    <a href="/modules/inventory" class="btn btn-sm btn-outline-secondary">Manage Inventory</a>
                </div>
                <div class="row g-3">
                    <% inventoryItems.forEach(function(item) { %>
                        <div class="col-md-4 col-xl-2">
                            <div class="p-3 rounded-3 border <%= item.current_stock <= item.reorder_level ? 'border-danger bg-danger-subtle bg-opacity-25' : 'bg-light' %>">
                                <div class="small text-muted text-truncate"><%= item.item_code %></div>
                                <div class="fw-semibold text-truncate" title="<%= item.name %>"><%= item.name %></div>
                                <div class="d-flex justify-content-between align-items-end mt-2">
                                    <div>
                                        <span class="fs-5 fw-bold <%= item.current_stock <= item.reorder_level ? 'text-danger' : 'text-dark' %>"><%= item.current_stock %></span>
                                        <small class="text-muted"><%= item.unit %></small>
                                    </div>
                                    <small class="text-muted">Min: <%= item.reorder_level %></small>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('layouts/footer') %>
