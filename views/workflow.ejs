<%- include('layouts/header') %>
<%- include('layouts/sidebar') %>

<main class="col-lg-10 p-4">
    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="window.history.back();">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
        <h2 class="fw-bold mb-1">Approval Workflow Architecture</h2>
        <p class="text-muted mb-4">Define sequential authorization stages for procurement, requisitions, and capital expenditure.</p>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 rounded-4 border bg-light">
                    <span class="badge bg-primary mb-2">Stage 1</span>
                    <h5 class="fw-bold">Field / Site Request</h5>
                    <p class="small text-muted mb-2">Site Engineer or Department Officer raises requisition with BoQ reference and site justification.</p>
                    <span class="badge bg-success-subtle text-success">Mandatory Step</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 border bg-light">
                    <span class="badge bg-warning text-dark mb-2">Stage 2</span>
                    <h5 class="fw-bold">Procurement & Store Audit</h5>
                    <p class="small text-muted mb-2">Store Officer verifies inventory balances; Procurement Officer matches supplier quotes and pricing.</p>
                    <span class="badge bg-success-subtle text-success">Mandatory Step</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 border bg-light">
                    <span class="badge bg-danger mb-2">Stage 3</span>
                    <h5 class="fw-bold">Executive Signoff</h5>
                    <p class="small text-muted mb-2">Managing Director / Finance Manager issues final electronic authorization for dispatch or PO creation.</p>
                    <span class="badge bg-success-subtle text-success">Mandatory Step</span>
                </div>
            </div>
        </div>

        <div class="mt-4 p-3 bg-primary-subtle bg-opacity-25 rounded-3 border border-primary-subtle">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                <div class="small text-primary-emphasis">
                    Approval thresholds: Requisitions under ₦500,000 auto-route to Procurement Officer. Requisitions ₦500,000+ require Managing Director sign-off.
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('layouts/footer') %>
